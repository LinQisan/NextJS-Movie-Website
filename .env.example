TMDB_Bearer=your_tmdb_api_bearer_token
# Optional: enables Rotten Tomatoes and Metacritic scores from OMDb.
OMDB_API_KEY=your_omdb_api_key

# Optional: Bangumi animation data. Public subject reads work without a token.
# Use a project-specific User-Agent as recommended by Bangumi.
BANGUMI_USER_AGENT="Eiseki/0.1.0 (https://github.com/LinQisan/NextJS-Movie-Website)"
# Optional: enables access to authorized Bangumi content.
BANGUMI_ACCESS_TOKEN=
